{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":pinAllExceptPeerDependencies"
  ],
  "rebaseWhen": "automerging",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "semanticCommits": "enabled"
}
