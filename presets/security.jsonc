{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "1 day",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "groupName": "{{datasource}}-{{packageName}} vulnerability updates",
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "description": "release timestamp が無い更新タイプで automerge が止まるのを防ぐ。",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "pin",
        "replacement",
        "bump",
        "rollback"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
